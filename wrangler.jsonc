{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openkuasa",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "OPENKUASA_PREVIEW": "1"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
